{
  "framework": "nextjs",
  "rootDirectory": "apps/web",
  "buildCommand": "cd ../.. && pnpm install && pnpm --filter=web build",
  "outputDirectory": "apps/web/.next",
  "installCommand": "pnpm install",
  "crons": [
    {
      "path": "/api/cron/booking-reminders",
      "schedule": "0 * * * *"
    }
  ]
}
