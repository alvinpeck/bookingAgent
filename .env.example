# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
# Primary PostgreSQL connection (pooled, e.g. Supabase/Neon pooler)
DATABASE_URL="postgresql://user:password@host:5432/booking_agent?sslmode=require"

# Direct (non-pooled) connection used by Drizzle migrations only
DATABASE_URL_DIRECT="postgresql://user:password@host:5432/booking_agent?sslmode=require"

# ─────────────────────────────────────────────
# CLERK AUTH
# ─────────────────────────────────────────────
# From Clerk dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# After sign-in/up, redirect to back-office dashboard
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/onboarding"

# Clerk webhook secret — used to sync org/user events into our DB
CLERK_WEBHOOK_SECRET="whsec_..."

# ─────────────────────────────────────────────
# GOOGLE CALENDAR OAUTH  (Phase 6 — fill later)
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must match the redirect URI registered in Google Cloud Console
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"

# ─────────────────────────────────────────────
# ENCRYPTION
# ─────────────────────────────────────────────
# 32-byte hex string used to encrypt stored OAuth refresh tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="replace_with_64_char_hex_string"

# ─────────────────────────────────────────────
# WHATSAPP  (Phase 9 — fill later)
# ─────────────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# ─────────────────────────────────────────────
# TELEGRAM  (Phase 9 — fill later)
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""

# ─────────────────────────────────────────────
# AI  (Phase 10 — fill later)
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=""
# or OPENAI_API_KEY=""

# ─────────────────────────────────────────────
# REDIS  (required from Phase 2 onwards)
# ─────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
