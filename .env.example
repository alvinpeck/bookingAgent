# ─── Database (Neon / Postgres) ───────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DATABASE_URL_DIRECT="postgresql://user:password@host:5432/dbname?sslmode=require"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
AUTH_SECRET="replace_with_32+_char_random_string"
NEXTAUTH_URL="http://localhost:3000"

# ─── Google OAuth (optional — enables Google sign-in) ────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Redis (Upstash or local) ─────────────────────────────────────────────────
# Upstash TLS: rediss://default:<token>@<host>.upstash.io:6379
REDIS_URL="redis://localhost:6379"

# ─── Encryption (store API keys encrypted in DB) ─────────────────────────────
# Must be exactly 64 hex characters (32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="replace_with_64_char_hex_string"

# ─── Admin portal JWT ─────────────────────────────────────────────────────────
# Must be at least 32 characters. Separate from AUTH_SECRET.
JWT_SECRET="replace_with_32+_char_random_string"

# ─── Cron job security ────────────────────────────────────────────────────────
CRON_SECRET="replace_with_random_string"

# ─── App URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=""
# RESEND_FROM_EMAIL="Your Business <noreply@yourdomain.com>"

# ─── Stripe (billing) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_ENTERPRISE=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ─── Google Calendar integration ──────────────────────────────────────────────
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"

# ─── WhatsApp (Meta Cloud API) — set per-channel in the Channels UI ──────────
WHATSAPP_APP_SECRET=""

# ─── Twilio (SMS reminders) ───────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ─── Node environment ─────────────────────────────────────────────────────────
NODE_ENV="development"
